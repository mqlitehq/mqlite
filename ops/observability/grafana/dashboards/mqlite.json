    {
      "id": 23,
      "type": "timeseries",
      "title": "Maintenance last success age",
      "description": "Time since the last successful pass for enabled tasks. Disabled tasks and tasks with no successful pass are omitted, not shown as epoch-sized ages; compare enabled status and maintenance outcomes.",
      "gridPos": {
        "x": 12,
        "y": 66,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - (mqlite_maintenance_last_success_timestamp_seconds{instance=~\"$instance\"} > 0)) and on(instance,job,task) (mqlite_maintenance_enabled{instance=~\"$instance\"} == 1)",
