    {
      "id": 17,
      "type": "timeseries",
      "title": "Storage operations by outcome",
      "description": "Unknown outcome means commit status is uncertain; do not classify it as a known rollback.",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome,error_code) (rate(mqlite_storage_operations_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} / {{outcome}} / {{error_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Storage retries",
      "description": "Retries are storage attempts, not redelivered messages or SDK HTTP retries.",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,outcome,error_code) (increase(mqlite_storage_retries_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{operation}} / {{outcome}} / {{error_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
