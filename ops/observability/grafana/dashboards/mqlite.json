      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mqlite_storage_ping_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{task}}",
