# HELP mqlite_info Broker build and storage backend information.
# TYPE mqlite_info gauge
mqlite_info{version="0.3.2",backend="local",schema_version="5"} 1
# HELP mqlite_storage_read_available Whether the latest SELECT 1 read probe succeeded; not a write health check.
# TYPE mqlite_storage_read_available gauge
mqlite_storage_read_available 1
# HELP mqlite_storage_ping_seconds Elapsed SELECT 1 read probe time, absent on failure.
# TYPE mqlite_storage_ping_seconds gauge
mqlite_storage_ping_seconds 0.00125
# HELP mqlite_storage_size_available Whether local database, WAL and SHM footprint measurement is available.
# TYPE mqlite_storage_size_available gauge
mqlite_storage_size_available 1
# HELP mqlite_storage_size_bytes Local database, WAL and SHM bytes, absent for memory, remote or unavailable files.
# TYPE mqlite_storage_size_bytes gauge
mqlite_storage_size_bytes 123456
# HELP mqlite_start_time_seconds Engine start time as Unix seconds.
# TYPE mqlite_start_time_seconds gauge
mqlite_start_time_seconds 1.7e+09
# HELP mqlite_sample_timestamp_seconds Queue sample time as Unix seconds.
# TYPE mqlite_sample_timestamp_seconds gauge
mqlite_sample_timestamp_seconds 1.7000000025e+09
# HELP mqlite_collection_last_success_timestamp_seconds Most recent successful queue collection as Unix seconds, or zero before success.
# TYPE mqlite_collection_last_success_timestamp_seconds gauge
mqlite_collection_last_success_timestamp_seconds 1.7000000025e+09
# HELP mqlite_collection_duration_seconds Elapsed time of the latest queue collection.
# TYPE mqlite_collection_duration_seconds gauge
mqlite_collection_duration_seconds 0.0015
# HELP mqlite_collection_success Whether the latest queue collection succeeded.
# TYPE mqlite_collection_success gauge
mqlite_collection_success 1
# HELP mqlite_collection_status Latest collection availability and bounded failure classification.
# TYPE mqlite_collection_status gauge
mqlite_collection_status{state="available",error_code=""} 1
# HELP mqlite_entities Configured non-subscription queues and subscriptions.
# TYPE mqlite_entities gauge
mqlite_entities{kind="queue"} 1
mqlite_entities{kind="subscription"} 1
# HELP mqlite_queue_messages Messages in a queue by state.
# TYPE mqlite_queue_messages gauge
mqlite_queue_messages{queue="orders	line\n\"quote\\雪",state="active"} 1
mqlite_queue_messages{queue="orders	line\n\"quote\\雪",state="locked"} 2
mqlite_queue_messages{queue="orders	line\n\"quote\\雪",state="deferred"} 3
mqlite_queue_messages{queue="orders	line\n\"quote\\雪",state="scheduled"} 4
mqlite_queue_messages{queue="orders	line\n\"quote\\雪",state="dead_lettered"} 5
mqlite_queue_messages{queue="worker",state="active"} 0
mqlite_queue_messages{queue="worker",state="locked"} 0
mqlite_queue_messages{queue="worker",state="deferred"} 0
mqlite_queue_messages{queue="worker",state="scheduled"} 0
mqlite_queue_messages{queue="worker",state="dead_lettered"} 0
# HELP mqlite_queue_retained_messages All retained message rows, including unexpected states.
# TYPE mqlite_queue_retained_messages gauge
mqlite_queue_retained_messages{queue="orders	line\n\"quote\\雪"} 21
mqlite_queue_retained_messages{queue="worker"} 0
# HELP mqlite_queue_unexpected_messages Retained rows outside the five normal working states.
# TYPE mqlite_queue_unexpected_messages gauge
mqlite_queue_unexpected_messages{queue="orders	line\n\"quote\\雪"} 6
mqlite_queue_unexpected_messages{queue="worker"} 0
# HELP mqlite_queue_oldest_message_age_seconds Age of the oldest active or locked message in seconds, zero when absent.
# TYPE mqlite_queue_oldest_message_age_seconds gauge
mqlite_queue_oldest_message_age_seconds{queue="orders	line\n\"quote\\雪"} 1.25
mqlite_queue_oldest_message_age_seconds{queue="worker"} 0
# HELP mqlite_queue_total Total messages in a queue.
# TYPE mqlite_queue_total gauge
mqlite_queue_total{queue="orders	line\n\"quote\\雪"} 21
mqlite_queue_total{queue="worker"} 0
# HELP mqlite_queue_oldest_message_age_ms Age of the oldest active or locked message in a queue, in milliseconds.
# TYPE mqlite_queue_oldest_message_age_ms gauge
mqlite_queue_oldest_message_age_ms{queue="orders	line\n\"quote\\雪"} 1250
mqlite_queue_oldest_message_age_ms{queue="worker"} 0
